# ============================================================
# 환경 변수 예시 — 이 파일을 복사해 .env 를 만드세요 (README 참고)
# 절대 실제 API 키를 Git에 올리지 마세요. .env 는 .gitignore 처리됨.
# ============================================================

# [필수] Google AI Studio / Gemini API 키
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [선택] 생성·검수·결재에 쓰는 LLM (실험군·대조군 동일)
GEMINI_MODEL=gemini-2.5-flash-lite

# [선택] 429/503 시 폴백 모델 (비우면 폴백 없음)
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# [선택] 벡터 임베딩 모델
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# [선택] API 재시도 (429 quota/rate limit)
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BASE_SEC=2.0

# [선택] Chroma 컬렉션 이름
CHROMA_COLLECTION_PROPOSED=rag_proposed
CHROMA_COLLECTION_LEGACY=rag_legacy

# [선택] 검수·결재 임계값 (0.0 ~ 1.0)
VERIFIER_MIN_SEMANTIC_SIMILARITY=0.45
VERIFIER_MIN_LLM_SCORE=0.55
APPROVER_MIN_OVERALL=0.60

# [선택] 크롤링: http = Playwright 불필요(권장), browser = Chromium 필요
CRAWL_MODE=http
CRAWL_TIMEOUT_SEC=60
MAX_COLLECT_RETRIES=2
MAX_URLS_PER_RUN=5

# [선택] 청킹
LEGACY_CHUNK_TOKENS=500
LEGACY_CHARS_PER_TOKEN=4
ADAPTIVE_MAX_CHUNK_CHARS=3500
ADAPTIVE_MIN_CHUNK_CHARS=200
PROPOSED_MAX_CHUNKS_PER_DOC=3

# [선택] RAG 검색 개수
RAG_TOP_K=5
